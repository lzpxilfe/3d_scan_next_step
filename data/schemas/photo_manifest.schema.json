{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archphoto/schemas/photo_manifest.schema.json",
  "title": "Photo manifest",
  "description": "Records originals without overwriting them. sha256 enables later integrity checks; originals are preserved, never auto-deleted.",
  "type": "object",
  "required": ["photos"],
  "properties": {
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["photo_id", "path"],
        "properties": {
          "photo_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "description": "Path to the ORIGINAL file. Program must not modify it." },
          "capture_role": { "enum": ["object", "scale", "reference", "unknown"] },
          "camera_id": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "acquired_at": { "type": ["string", "null"], "format": "date-time" },
          "width_px": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
          "height_px": { "type": ["integer", "null"], "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
